APP_NAME="Sasurie ERP"
ENVIRONMENT=development
DEBUG=true

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=edsolutionserp

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@sasurie.edu.in
SMTP_FROM_NAME="Sasurie Group of Institutions"

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOCAL_STORAGE_ROOT=./storage
